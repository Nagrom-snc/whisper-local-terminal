#!/usr/bin/env python3
"""Transcribe one local recording with whisper.cpp without overwriting files."""

from __future__ import annotations

import argparse
import math
import os
import re
import resource
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import List, Optional, Tuple


def output_paths(prefix: Path) -> Tuple[Path, Path]:
    return Path(str(prefix) + ".txt"), Path(str(prefix) + ".srt")


def path_taken(directory_fd: int, name: str) -> bool:
    try:
        os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
    except FileNotFoundError:
        return False
    return True


def next_prefix(directory: Path, stem: str, directory_fd: int) -> Path:
    base = f"{stem}_transcript"
    candidate = directory / base
    number = 2
    while any(path_taken(directory_fd, path.name) for path in output_paths(candidate)):
        candidate = directory / f"{base}_{number}"
        number += 1
    return candidate


def publish_file(source: Path, destination: Path, directory_fd: int) -> None:
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW
    with source.open("rb") as incoming:
        descriptor = os.open(destination.name, flags, 0o666, dir_fd=directory_fd)
        with os.fdopen(descriptor, "wb") as outgoing:
            shutil.copyfileobj(incoming, outgoing)


def publish_outputs(staged_prefix: Path, directory: Path, stem: str,
                    directory_fd: int) -> Tuple[Path, Path]:
    staged_txt, staged_srt = output_paths(staged_prefix)
    while True:
        prefix = next_prefix(directory, stem, directory_fd)
        txt, srt = output_paths(prefix)
        try:
            publish_file(staged_txt, txt, directory_fd)
        except FileExistsError:
            continue
        try:
            publish_file(staged_srt, srt, directory_fd)
        except FileExistsError as exc:
            raise OSError(f"SRT name became occupied after TXT was published at {txt}; TXT was kept") from exc
        return txt, srt


def format_duration(seconds: float) -> str:
    if seconds < 60:
        return f"{seconds:.1f}s"
    minutes, remaining = divmod(round(seconds), 60)
    hours, minutes = divmod(minutes, 60)
    if hours:
        return f"{hours}h {minutes}m {remaining}s"
    return f"{minutes}m {remaining}s"


def audio_duration(audio: Path) -> Optional[float]:
    if shutil.which("ffprobe") is None:
        return None
    result = subprocess.run(
        ["ffprobe", "-v", "error", "-show_entries", "format=duration",
         "-of", "default=noprint_wrappers=1:nokey=1", str(audio)],
        capture_output=True, text=True, check=False,
    )
    if result.returncode != 0:
        return None
    try:
        duration = float(result.stdout.strip())
        return duration if math.isfinite(duration) and duration > 0 else None
    except ValueError:
        return None


def run_whisper(command: List[str], log_path: Path) -> Tuple[int, str]:
    progress_pattern = re.compile(r"progress\s*=\s*(\d+)%")
    last_progress = -1
    with log_path.open("w", encoding="utf-8") as log:
        with subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              text=True, encoding="utf-8", errors="replace",
                              bufsize=1) as process:
            assert process.stdout is not None
            for line in process.stdout:
                log.write(line)
                match = progress_pattern.search(line)
                if match:
                    progress = int(match.group(1))
                    if progress != last_progress:
                        print(f"Progress: {progress}%", flush=True)
                        last_progress = progress
            exit_code = process.wait()
    return exit_code, log_path.read_text(encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description="Offline whisper.cpp transcription")
    parser.add_argument("audio", nargs="?", type=Path, help="input audio or video file")
    parser.add_argument("--language", default="yue", help="Whisper language code (default: yue)")
    parser.add_argument("--model", type=Path, help="GGML model file")
    parser.add_argument("--output-dir", type=Path, help="directory for TXT and SRT")
    parser.add_argument("--cpu", action="store_true", help="use CPU without first trying GPU")
    args = parser.parse_args()

    if args.audio is None:
        if sys.platform != "darwin" or shutil.which("osascript") is None:
            parser.error("provide an input audio file")
        selection = subprocess.run(
            ["osascript", "-e", 'POSIX path of (choose file with prompt "選擇要轉錄的錄音或影片")'],
            capture_output=True, text=True, check=False,
        )
        if selection.returncode != 0:
            if "User canceled" in selection.stderr:
                print("No file selected.")
                return 0
            parser.error("could not open the file chooser")
        args.audio = Path(selection.stdout.rstrip("\r\n"))

    audio = args.audio.expanduser().resolve()
    model_default = os.environ.get("WHISPER_YUE_MODEL")
    model = (args.model or (Path(model_default) if model_default else
             Path.home().joinpath("whisper-local", "models", "ggml-large-v3.bin"))).expanduser().resolve()
    output_dir = (args.output_dir or audio.parent).expanduser().resolve()

    if not audio.is_file():
        parser.error("input audio file does not exist")
    if not model.is_file():
        parser.error("GGML model file does not exist; provide --model or install large-v3")
    for executable in ("ffmpeg", "whisper-cli"):
        if shutil.which(executable) is None:
            parser.error(f"{executable} is not installed or not on PATH")

    output_dir.mkdir(parents=True, exist_ok=True)
    duration = audio_duration(audio)
    start_time = time.perf_counter()
    usage_before = resource.getrusage(resource.RUSAGE_CHILDREN)
    backend = "CPU" if args.cpu else "whisper.cpp default"

    directory_fd = None
    try:
        directory_fd = os.open(output_dir, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
        with tempfile.TemporaryDirectory(prefix="whisper-transcribe-") as temp_dir:
            wav = Path(temp_dir) / "input.wav"
            staged_prefix = Path(temp_dir) / "transcript"
            print("Preparing audio...", flush=True)
            subprocess.run(
                ["ffmpeg", "-hide_banner", "-loglevel", "error", "-i", str(audio),
                 "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", str(wav)],
                check=True,
            )
            command = [
                "whisper-cli", "--model", str(model), "--file", str(wav),
                "--language", args.language, "--output-txt", "--output-srt",
                "--output-file", str(staged_prefix), "--print-progress",
            ]
            log_path = Path(temp_dir) / "whisper.log"
            print("Transcribing locally...", flush=True)
            exit_code, log_text = run_whisper(command + (["--no-gpu"] if args.cpu else []), log_path)
            if exit_code != 0 and not args.cpu and (
                "failed to allocate Metal buffer" in log_text or
                "ggml_metal_buffer_init: error" in log_text
            ):
                print("Metal memory allocation failed; retrying on CPU...", flush=True)
                backend = "CPU"
                exit_code, log_text = run_whisper(command + ["--no-gpu"], log_path)
            if exit_code != 0:
                print("\n".join(log_text.splitlines()[-20:]), file=sys.stderr)
                print(f"Transcription failed in whisper-cli (exit {exit_code}).", file=sys.stderr)
                return exit_code if exit_code > 0 else 1
            if backend == "whisper.cpp default" and "ggml_metal" in log_text.lower():
                backend = "Metal/GPU"
            staged_txt, staged_srt = output_paths(staged_prefix)
            if not staged_txt.is_file() or not staged_srt.is_file():
                print("Transcription command completed but expected TXT/SRT output is missing.", file=sys.stderr)
                return 1
            txt, srt = publish_outputs(staged_prefix, output_dir, audio.stem, directory_fd)
    except subprocess.CalledProcessError as exc:
        print(f"Transcription failed in {exc.cmd[0]} (exit {exc.returncode}).", file=sys.stderr)
        return exc.returncode or 1
    except OSError as exc:
        print(f"Could not safely publish transcript files: {exc}", file=sys.stderr)
        return 1
    finally:
        if directory_fd is not None:
            os.close(directory_fd)
    elapsed = time.perf_counter() - start_time
    usage_after = resource.getrusage(resource.RUSAGE_CHILDREN)
    cpu_time = ((usage_after.ru_utime + usage_after.ru_stime) -
                (usage_before.ru_utime + usage_before.ru_stime))
    peak_bytes = usage_after.ru_maxrss * (1 if sys.platform == "darwin" else 1024)
    print(f"Backend: {backend}")
    if duration is not None:
        print(f"Audio: {format_duration(duration)}")
    print(f"Elapsed: {format_duration(elapsed)}")
    if duration is not None and elapsed > 0:
        print(f"Speed: {duration / elapsed:.2f}x real time")
    print(f"CPU time: {format_duration(cpu_time)}")
    print(f"Peak child RAM: {peak_bytes / (1024 ** 3):.2f} GiB")
    print(f"TXT: {txt}")
    print(f"SRT: {srt}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
